<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Dataverse classic plugin assembly: .NET Framework 4.6.2, strong-name signed, sandbox isolation. -->
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>DefaultUserSettings.Plugins</AssemblyName>
    <RootNamespace>DefaultUserSettings.Plugins</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>DefaultUserSettings.Plugins.snk</AssemblyOriginatorKeyFile>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
